{
  "key": "veroscholar_literature_review",
  "name": "文献综述生成 v5",
  "name_i18n_key": "workflow.veroscholar.lit_review.name",
  "description": "多库检索 → 确定性去重排序 → 生成综述 → 通知完成（全自定义节点，数据经 node_*_output 传递）",
  "description_i18n_key": "workflow.veroscholar.lit_review.desc",
  "triggers": [],
  "max_concurrency": 1,
  "timeout_minutes": 60,
  "on_error": "pause",
  "definition": {
    "nodes": [
      {
        "id": "n1",
        "type": "veroscholar_search",
        "name": "多库文献检索",
        "config": {
          "sources": ["arxiv", "semantic", "openalex", "openalex_zh"],
          "limit": 30,
          "per_source": 8,
          "keywords_field": "keywords",
          "output_field": "papers"
        },
        "position": { "x": 100, "y": 100 }
      },
      {
        "id": "n2",
        "type": "veroscholar_dedup",
        "name": "去重与排序",
        "config": {
          "papers_field": "papers",
          "output_field": "papers"
        },
        "position": { "x": 400, "y": 100 }
      },
      {
        "id": "n3",
        "type": "veroscholar_review_gen",
        "name": "生成综述",
        "config": {
          "papers_field": "papers",
          "max_papers": 20
        },
        "position": { "x": 700, "y": 100 }
      },
      {
        "id": "n4",
        "type": "notify",
        "name": "通知完成",
        "config": {
          "channels": ["notification"],
          "title": "文献综述生成完成",
          "title_i18n_key": "workflow.veroscholar.lit_review.notify"
        },
        "position": { "x": 1000, "y": 100 }
      }
    ],
    "edges": [
      { "from": "n1", "to": "n2", "condition": "success" },
      { "from": "n2", "to": "n3", "condition": "success" },
      { "from": "n3", "to": "n4", "condition": "success" }
    ]
  }
}
